# ============================================================
# CONFIGURACION DEL SERVIDOR
# ============================================================
server.port=8080

# ============================================================
# SUPABASE AUTH (solo para registro e inicio de sesion)
# ============================================================
# Sacar de: Supabase -> su proyecto -> Project Settings -> API
supabase.url=https://TU_PROYECTO.supabase.co
supabase.anonKey=TU_ANON_KEY

# ============================================================
# CONEXION JDBC DIRECTA A POSTGRESQL (via Connection Pooler)
# ============================================================
# Sacar de: Supabase -> su proyecto -> Project Settings -> Database
#           -> seccion "Connection Pooling" -> modo "Session"
#
# El host se ve algo asi: aws-0-us-west-1.pooler.supabase.com
# El usuario se ve algo asi: postgres.xwhmlaxjjxxkrdmbzqaa
# La contraseña es la que definieron al crear el proyecto en Supabase
# (si no la recuerdan, se puede resetear en esa misma pantalla).
spring.datasource.url=jdbc:postgresql://TU_HOST_POOLER.pooler.supabase.com:5432/postgres
spring.datasource.username=postgres.TU_ID_PROYECTO
spring.datasource.password=TU_PASSWORD
spring.datasource.driver-class-name=org.postgresql.Driver

# ============================================================
# CONFIGURACION DE JPA / HIBERNATE
# ============================================================
# "validate" (no "update" ni "create"): las tablas ya existen, las
# creamos nosotros mismos con SQL en el panel de Supabase. Con esto,
# Hibernate solo verifica que las entidades @Entity coincidan con las
# tablas reales, pero NUNCA las modifica automaticamente.
spring.jpa.hibernate.ddl-auto=validate
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.PostgreSQLDialect

# Muestra en la consola el SQL que genera Hibernate; util mientras
# desarrollan, para ver exactamente que se esta ejecutando. Se puede
# poner en "false" mas adelante si genera mucho ruido en la consola.
spring.jpa.show-sql=true
spring.datasource.hikari.maximum-pool-size=3
